Options -Indexes

<FilesMatch "\.(js|json|yml|yaml|sql|md|env|example|log|gitignore)$">
  Require all denied
</FilesMatch>

<Files "Dockerfile">
  Require all denied
</Files>

<Files "config.local.json">
  Require all denied
</Files>

# Beget Node.js (Passenger). Paths are account-specific — verify after copy.
PassengerEnabled On
PassengerAppType node
PassengerStartupFile passenger.cjs
PassengerFriendlyErrorPages off
PassengerNodejs /home/b/biker9td/biker9td.beget.tech/nodejs/bin/node
PassengerAppRoot /home/b/biker9td/biker9td.beget.tech/public_html
