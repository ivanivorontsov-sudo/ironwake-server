Options -Indexes

<FilesMatch "\.(js|json|yml|yaml|sql|md|env|example|log|gitignore)$">
  Require all denied
</FilesMatch>

<Files "Dockerfile">
  Require all denied
</Files>

<Files "config.local.json">
  Require all denied
</Files>

# Beget Node (Passenger). Keep enabled so deploys don't kill /health.
PassengerEnabled On
PassengerAppType node
PassengerStartupFile passenger.cjs
